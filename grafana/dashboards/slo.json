{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "ym-slo-sla",
    "labels": {
      "app": "ym",
      "scope": "observability"
    }
  },
  "spec": {
    "title": "YM — SLI / SLO / SLA",
    "description": "SLI/SLO/SLA для HTTP-ручек и очереди треков",
    "tags": ["sli", "slo", "sla", "ym"],
    "editable": true,
    "graphTooltip": 1,
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-6h", "to": "now" },
    "timezone": "browser",
    "links": [],
    "annotations": { "list": [] },
    "templating": {
      "list": [
        {
          "name": "DS_PROMETHEUS",
          "label": "Prometheus",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false
        }
      ]
    },
    "panels": [
      {
        "id": 100,
        "type": "row",
        "title": "1. P95 latency — ручки без аудио (SLO 100ms / SLA 150ms)",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "panels": []
      },
      {
        "id": 1,
        "type": "timeseries",
        "title": "SLI: P95 latency (без /tracks*, служебных роутов)",
        "description": "P95 времени ответа по всем роутам, кроме /tracks, /tracks/* и служебных (/metrics, /ping, /swagger/*, /openapi.yml). SLO=100ms, SLA=150ms.",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "lineWidth": 2, "fillOpacity": 10 },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.1 },
                { "color": "red", "value": 0.15 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "P95",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(0.95, sum by (le) (rate(ym_http_request_duration_s_bucket{route!~\"/tracks.*|/metrics|/ping|/swagger/.*|/openapi.yml\"}[$__rate_interval])))",
            "legendFormat": "P95 SLI"
          },
          {
            "refId": "SLO",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "vector(0.1)",
            "legendFormat": "SLO 100ms"
          },
          {
            "refId": "SLA",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "vector(0.15)",
            "legendFormat": "SLA 150ms"
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Статус SLO / SLA (P95)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.1 },
                { "color": "red", "value": 0.15 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(0.95, sum by (le) (rate(ym_http_request_duration_s_bucket{route!~\"/tracks.*|/metrics|/ping|/swagger/.*|/openapi.yml\"}[$__rate_interval])))",
            "legendFormat": "P95"
          }
        ]
      },

      {
        "id": 101,
        "type": "row",
        "title": "2. P100 (max) latency — POST /tracks (SLO 3s / SLA 5s)",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
        "panels": []
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "SLI: P100 latency POST /tracks",
        "description": "P100 = верхняя граница гистограммы (+Inf bucket / max). Используем histogram_quantile(1.0). SLO=3s, SLA=5s.",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 16, "x": 0, "y": 11 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "lineWidth": 2, "fillOpacity": 10 },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 1.2 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "P100",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(1.0, sum by (le) (rate(ym_http_request_duration_s_bucket{method=\"POST\",route=\"/tracks\"}[$__rate_interval])))",
            "legendFormat": "P100 POST /tracks"
          },
          {
            "refId": "SLO",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "vector(3)",
            "legendFormat": "SLO 3s"
          },
          {
            "refId": "SLA",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "vector(5)",
            "legendFormat": "SLA 5s"
          }
        ]
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Статус SLO / SLA (P100)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 8, "x": 16, "y": 11 },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 3 },
                { "color": "red", "value": 5 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "histogram_quantile(1.0, sum by (le) (rate(ym_http_request_duration_s_bucket{method=\"POST\",route=\"/tracks\"}[$__rate_interval])))",
            "legendFormat": "P100"
          }
        ]
      },

      {
        "id": 102,
        "type": "row",
        "title": "3. % 5XX за 5 минут (SLO 1% / SLA 3%)",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
        "panels": []
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "SLI: доля 5XX ответов (5m)",
        "description": "Доля ответов со статусом 5xx за 5 минут. SLO=1%, SLA=3%.",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 16, "x": 0, "y": 21 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 3,
            "custom": { "lineWidth": 2, "fillOpacity": 10 },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.03 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "ERR",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "sum(rate(ym_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(ym_http_requests_total[5m])), 1e-9)",
            "legendFormat": "5XX ratio 5m"
          },
          {
            "refId": "SLO",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "vector(0.01)",
            "legendFormat": "SLO 1%"
          },
          {
            "refId": "SLA",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "vector(0.03)",
            "legendFormat": "SLA 3%"
          }
        ]
      },
      {
        "id": 6,
        "type": "stat",
        "title": "Статус SLO / SLA (5XX)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 8, "x": 16, "y": 21 },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.01 },
                { "color": "red", "value": 0.03 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "sum(rate(ym_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(ym_http_requests_total[5m])), 1e-9)",
            "legendFormat": "5XX"
          }
        ]
      },

      {
        "id": 103,
        "type": "row",
        "title": "4. Треки в очереди с ошибкой (SLO ≤10, SLA нет)",
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
        "panels": []
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "SLI: ym_current_transcoding_queue_size{type=\"failed\"}",
        "description": "Количество треков в очереди с ошибкой. SLO ≤ 10. SLA не задан. Для контекста показан также type=\"active\".",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 16, "x": 0, "y": 31 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "custom": { "lineWidth": 2, "fillOpacity": 10 },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 10 }
              ]
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "active" },
              "properties": [
                { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
                { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
                { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
              ]
            }
          ]
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
          "tooltip": { "mode": "multi", "sort": "desc" }
        },
        "targets": [
          {
            "refId": "FAILED",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "max(ym_current_transcoding_queue_size{type=\"failed\"})",
            "legendFormat": "failed"
          },
          {
            "refId": "ACTIVE",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "max(ym_current_transcoding_queue_size{type=\"active\"})",
            "legendFormat": "active"
          },
          {
            "refId": "SLO",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "vector(10)",
            "legendFormat": "SLO 10"
          }
        ]
      },
      {
        "id": 8,
        "type": "stat",
        "title": "Статус SLO (queue failed)",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "gridPos": { "h": 9, "w": 8, "x": 16, "y": 31 },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 10 }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "textMode": "auto"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
            "expr": "max(ym_current_transcoding_queue_size{type=\"failed\"})",
            "legendFormat": "failed"
          }
        ]
      }
    ]
  }
}
