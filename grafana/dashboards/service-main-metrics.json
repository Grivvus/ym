            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "editorMode": "code",
            "expr": "sum(go_memstats_alloc_bytes{job=\"$job\", instance=~\"$instance\"})",
            "legendFormat": "allocated",
            "range": true,
            "refId": "A"
