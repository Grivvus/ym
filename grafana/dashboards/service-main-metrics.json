          "type": "prometheus",
          "uid": "${datasource}"
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "pluginVersion": "13.0.0",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
